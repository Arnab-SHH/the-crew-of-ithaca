# The Crew of Ithaca — shared settings for backend/ and ml-sensor-node/
# Copy this file to .env (git-ignored) and fill in your keys.
# Keys the ElevenLabs / Chert CLIs write to .env.local take priority over .env.
# Leave CHERT_LINE_ID blank to use the first line in your Chert project.

# ---- Backend ----
PORT=4000
# local = auto-launch the Python sensor only for a browser on this computer (default)
# always = auto-launch for every player | never = players start the sensor themselves
AUTO_SPAWN=local
# Python used for the auto-launched sensor. Leave blank to use ml-sensor-node/.venv, then python/python3.
PYTHON_BIN=

# ---- Chert (iMessage + FaceTime) — https://app.trychert.com ----
CHERT_API_KEY=
CHERT_PROJECT_ID=bbebbb39-f40a-4ef1-977c-ac731eb68299
CHERT_LINE_ID=
# Published "Captain Odysseus" managed assistant (see README)
CHERT_ASSISTANT_ID=
# Optional: require "Authorization: Bearer <secret>" on POST /api/chert-webhook
CHERT_WEBHOOK_SECRET=
# outbound (default) = Captain Odysseus FaceTimes the player on damage (uses captain-agent/.env.local LiveKit keys)
# inbound = the player FaceTimes the Chert number instead
CAPTAIN_CALLS=outbound

# ---- ElevenLabs (Captain's voice) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ---- ML sensor defaults (when you run main.py by hand) ----
PLAYER_NAME=Arnab
ROOM_CODE=ITHACA_1
PLAYER_PHONE=
BACKEND_URL=http://localhost:4000
CAMERA_INDEX=0
