# Captain Odysseus — copy this file to .env.local and fill it in. Never commit or share .env.local.
# On the Chert free trial / Shared plan, leave all three LiveKit values empty: calls run in Chert's LiveKit.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Fill in ONE model key.
# Free option: a Google Gemini API key from aistudio.google.com (voice + the notebook photo check).
GOOGLE_API_KEY=
# Paid option: an OpenAI key with Realtime access and credits. Used only when GOOGLE_API_KEY is empty.
OPENAI_API_KEY=

# Optional model overrides. Leave GEMINI_LIVE_MODEL unset: "3.1" Live models can't speak first,
# so the Captain never greets and Chert ends the call after 10 seconds.
# GEMINI_VISION_MODEL=gemini-2.5-flash

# The name chert dev connects to. Keep it unique on the shared line.
AGENT_NAME=crew-of-ithaca-captain

# The game backend on this computer (heals the hull when the notebook is verified).
BACKEND_URL=http://localhost:4000
